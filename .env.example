# Copy to .env to override the defaults. Every value below is the default used by docker-compose.yml.
# All credentials are local development values. Never reuse them anywhere else.

# Object store
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
WAREHOUSE_BUCKET=warehouse

# Spark worker sizing. Lower these on a small machine (the demo needs at least 2g / 2 cores).
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_CORES=4

# Event producer. PRODUCER_MAX_EVENTS=0 means run until stopped.
EVENTS_FLEET_SIZE=20
EVENTS_TICK_SECONDS=1.0
PRODUCER_MAX_EVENTS=0
DUPLICATE_RATE=0.02
LATE_RATE=0.05
MALFORMED_RATE=0.02

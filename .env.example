# Copy to .env to override defaults. Every value below is the default used by docker-compose.yml.

# Object store (local development credentials, never reuse elsewhere)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
WAREHOUSE_BUCKET=warehouse

# Spark worker sizing. Lower these on a small machine.
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# Event producer
EVENTS_FLEET_SIZE=20
EVENTS_TICK_SECONDS=1.0
PRODUCER_MAX_EVENTS=0
DUPLICATE_RATE=0.02
LATE_RATE=0.05
MALFORMED_RATE=0.02
